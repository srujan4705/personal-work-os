# ─────────────────────────────────────────────────────────────────────────────
# Personal Work OS configuration. Copy to .env and fill in. Never commit .env.
# See docs/MANUAL_SETUP.md for where each value comes from.
# Empty values are treated as "not set".
# ─────────────────────────────────────────────────────────────────────────────

# === A. Required ===
# Public URL where you open the app (no trailing slash). Used for CORS, cookies, OAuth redirects.
APP_URL=http://localhost:3000
# Docker Compose database password (Compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Only needed when running WITHOUT Docker Compose:
DATABASE_URL=postgresql://pwos:change-me-to-a-long-random-password@localhost:5432/pwos
# Optional: CA certificate (PEM text, or base64 of it) to require VERIFIED TLS to the database,
# e.g. the Supabase CA. When set, sslmode/sslrootcert in DATABASE_URL are ignored.
DATABASE_SSL_CA=
# 64 hex characters (32 bytes). Generate: openssl rand -hex 32   (keep a backup; losing it means reconnecting Zoho)
TOKEN_ENCRYPTION_KEY=
# First login. The user is created on first start if the database has no users. Password: min 12 chars.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Me
# IANA timezone, e.g. Asia/Kolkata, Europe/Berlin, America/New_York (changeable later in Settings)
ADMIN_TIMEZONE=UTC

# === Server ===
PORT=3000
# Host port published by Docker Compose
HOST_PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (1 = Caddy/nginx; 2 = Vercel proxy + Render).
# Wrong values make rate limits see a proxy IP instead of yours. Verify via the "clientIp" log field.
TRUST_PROXY=1
# Cookies are Secure (HTTPS-only) in production. Set to false ONLY for plain-http access on a trusted LAN.
COOKIE_SECURE=
SESSION_TTL_DAYS=30
# In-process scheduler. Set false when an external trigger calls the cron endpoint (Render Free).
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
# Enables POST /api/v1/internal/cron/tick?scope=all|notifications|sync with
# "Authorization: Bearer <CRON_SECRET>". Empty = endpoint disabled. Min 32 chars: openssl rand -hex 32
CRON_SECRET=

# === H. Zoho (read-only) — optional ===
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# com | eu | in | com.au | jp | ca | sa  (the domain you use to log in to Zoho)
ZOHO_DATA_CENTER=com
# Must exactly match the redirect URI registered in the Zoho API console:
ZOHO_REDIRECT_URI=http://localhost:3000/api/v1/integrations/zoho/callback
ZOHO_SYNC_INTERVAL_MINUTES=30
ZOHO_SYNC_PAST_DAYS=14
ZOHO_SYNC_FUTURE_DAYS=14
# Logs the top-level keys (never values) of Zoho Sprints responses, to help map unusual payloads.
ZOHO_DEBUG_SHAPES=false

# === G. GitHub (read-only) — optional ===
# Fine-grained personal access token with READ-ONLY permissions (Contents, Metadata, Pull requests, Issues).
GITHUB_TOKEN=
# Optional comma-separated allow-list, e.g. acme/api,acme/web. Empty = all repos you can read (choose in Settings).
GITHUB_REPOS=
GITHUB_SYNC_INTERVAL_MINUTES=60
GITHUB_SYNC_DAYS=30

# === F. AI assistant — optional (the app works fully without it) ===
# none | gemini | openrouter | ollama  (default provider for a new user; changeable in Settings)
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# From inside Docker, a host Ollama is usually http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_TOOL_ROUNDS=5
AI_RETRY_LIMIT=1
AI_REQUESTS_PER_MINUTE=10
AI_TIMEOUT_MS=45000

# === E. Telegram — optional ===
# off | webhook (needs public HTTPS APP_URL) | polling (works behind NAT, no public URL)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string, only for webhook mode. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# === E. Email (SMTP) — optional ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Work OS <workos@example.com>
EMAIL_SUBJECT_PREFIX=[Work OS]

# === E. Browser push — optional ===
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# === Rate limits ===
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_ASSISTANT_PER_MIN=20
RATE_LIMIT_SYNC_PER_MIN=6
RATE_LIMIT_NOTIFY_PER_MIN=10
RATE_LIMIT_TELEGRAM_PER_MIN=60
RATE_LIMIT_CRON_PER_MIN=30
